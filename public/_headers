/*
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/push/onesignal/*
  Cache-Control: no-cache, must-revalidate

/OneSignalSDKWorker.js
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
