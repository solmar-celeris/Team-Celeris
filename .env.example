# Estes valores são públicos no navegador. Copie para .env.local após criar o projeto Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA
VITE_ACTIVITY_EMAILS_ENABLED=false
# App ID público do mesmo app OneSignal do push nativo; nunca coloque a REST API Key em VITE_.
VITE_ONESIGNAL_APP_ID=SUBSTITUA_PELO_APP_ID_PUBLICO
